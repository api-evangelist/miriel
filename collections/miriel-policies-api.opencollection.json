{
  "opencollection": "1.0.0",
  "info": {
    "name": "Miriel Context Engine Documents Policies API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-token",
      "value": "{{x-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user policies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.prod.miriel.ai/api/v2/get_user_policies"
          },
          "docs": "List user policies"
        },
        {
          "info": {
            "name": "Add a user policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.prod.miriel.ai/api/v2/add_user_policy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a user policy"
        },
        {
          "info": {
            "name": "Delete a user policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.prod.miriel.ai/api/v2/delete_user_policy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a user policy"
        }
      ]
    }
  ],
  "bundled": true
}