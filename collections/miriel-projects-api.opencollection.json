              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a project"
        },
        {
          "info": {
            "name": "Delete a project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.prod.miriel.ai/api/v2/delete_project",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a project"
        }
      ]
    }
